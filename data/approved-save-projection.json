    "yearBeats": [
      {
        "id": "n_job_36_loan_adv_ge28ylm26r9p_18",
        "day": 36,
        "text": "Íñigo Guzmán pasó una estación en cesión a La Guardia de Conchamuelle y ha vuelto a la casa."
      },
      {
        "id": "n_bond_home_36_adv_xvecyci8knko_adv_agorapai6eaw",
        "day": 36,
        "text": "Luna se rio de algo que dijo Jaro, y Jaro no lo había dicho en broma."
      },
      {
        "id": "n_ourdead_gift_adv_w21f5zhwf7li_34",
        "day": 34,
        "text": "Enterraron a Brugo detrás de la casa y levantaron un túmulo sobre su tumba, como harían con cualquiera de los suyos."
      },
      {
        "id": "n_warkinleft_33",
        "day": 33,
        "text": "🏚️ El Cindermoor ardió, y mandaste a otros pero dejaste a Belzar de la Ofrenda y Xara del Cuerno en casa. Su familia vivía allí. Desde entonces apenas te han dirigido la palabra."
      },
      {
        "id": "n_war_33",
        "day": 33,
        "text": "🗡️ El Asalto de Ashfall, en El Cindermoor: 4 marcharon, la coalición triunfó; 1 no volvieron."
      },
      {
        "id": "n_warhero_adv_agorapai6eaw_33",
        "day": 33,
        "text": "🗡️ Jaro salió de El Asalto de Ashfall con fama de héroe de guerra, y la fama se le ha quedado."
      },
      {
        "id": "n_vow_horn_33_adv_agorapai6eaw",
        "day": 33,
        "text": "🕊️ Jaro cumple un voto. El cuerno sonó, y esta casa acudió. No estaban junto al fuego cuando ocurrió."
      },
      {
        "id": "n_warkit_33",
        "day": 33,
        "text": "El equipo de los caídos se trajo a casa, a la armería."
      },
      {
        "id": "n_warcomrades_33",
        "day": 33,
        "text": "Ulf Vallehondo, Velasco Rivadeneira y Jaro volvieron sin Brugo."
